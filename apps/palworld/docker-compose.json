{
  "services": {
    "palworld": {
      "image": "thijsvanloef/palworld-server-docker:latest",
      "x-runtipi": {
        "is_main": true,
        "internal_port": 8211
      },
      "ports": [
        "8211:8211/udp",
        "27015:27015/udp"
      ],
      "environment": [
        "PUID=1000",
        "PGID=1000",
        "PORT=8211",
        "PLAYERS=32",
        "MULTITHREADING=true",
        "TZ=Asia/Jakarta",
        "ADMIN_PASSWORD=ChangeThisAdminPassword",
        "SERVER_PASSWORD=ChangeThisServerPassword",
        "SERVER_NAME=Runtipi Palworld Server",
        "SERVER_DESCRIPTION=Palworld Dedicated Server",
        "COMMUNITY=false",
        "UPDATE_ON_BOOT=true",
        "RCON_ENABLED=true",
        "RCON_PORT=25575",
        "REST_API_ENABLED=true",
        "REST_API_PORT=8212",
        "QUERY_PORT=27015",
        "CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)",
        "BACKUP_ENABLED=true",
        "BACKUP_CRON_EXPRESSION=0 0 * * *",
        "USE_BACKUP_SAVE_DATA=true",
        "DELETE_OLD_BACKUPS=false",
        "OLD_BACKUP_DAYS=30",
        "AUTO_UPDATE_ENABLED=false",
        "AUTO_UPDATE_CRON_EXPRESSION=0 * * * *",
        "AUTO_UPDATE_WARN_MINUTES=30",
        "AUTO_REBOOT_ENABLED=false",
        "AUTO_REBOOT_CRON_EXPRESSION=0 0 * * *",
        "AUTO_REBOOT_WARN_MINUTES=5",
        "AUTO_REBOOT_EVEN_IF_PLAYERS_ONLINE=false",
        "AUTO_PAUSE_ENABLED=false",
        "EXP_RATE=1.500000",
        "PAL_CAPTURE_RATE=1.500000",
        "PAL_EGG_DEFAULT_HATCHING_TIME=12.000000",
        "DEATH_PENALTY=Item",
        "B_ENABLE_INVADER_ENEMY=True",
        "COLLECTION_DROP_RATE=2.000000",
        "ENEMY_DROP_ITEM_RATE=2.000000"
      ],
      "volumes": [
        "./data:/palworld/"
      ]
    }
  },
  "x-runtipi": {
    "schema_version": 2
  }
}